# AudioDrop environment configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# ── Audio input ──────────────────────────────────────────────────────────────
# Number of audio channels: 1 = mono, 2 = stereo (1–8)
AUDIO_CHANNELS=1

# Sample rate in Hz (8000–192000)
AUDIO_RATE=44100

# Sample format: S16_LE, S24_LE, or S32_LE
AUDIO_FORMAT=S16_LE

# ALSA device to record from.
# Use "default" for the system default, or "list" to list available devices.
# Hardware device example: hw:0,0
AUDIO_DEVICE=default

# ── Recording segments ───────────────────────────────────────────────────────
# Duration of each recording file in seconds
RECORD_DURATION=60

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory inside the container where recordings are saved
OUTPUT_DIR=/recordings

# Minimum free disk space (MB) before recording is paused
MIN_DISK_MB=100
